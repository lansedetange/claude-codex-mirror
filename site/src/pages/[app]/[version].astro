---
import Base from "../../layouts/Base.astro";
import { marked } from "marked";
import { appIds, getApp, formatBytes, platformLabel } from "../../lib/manifest";

export function getStaticPaths() {
  const paths = [];
  for (const id of appIds()) {
    const app = getApp(id);
    if (!app) continue;
    for (const rel of app.releases) {
      paths.push({ params: { app: id, version: rel.version } });
    }
  }
  return paths;
}

const { app: appId, version } = Astro.params;
const app = getApp(appId!);
const release = app?.releases.find((r) => r.version === version);
if (!app || !release) throw new Error(`Unknown release ${appId}/${version}`);

const zhHtml = release.notes_zh ? marked.parse(release.notes_zh) : null;
const enHtml = release.notes_en ? marked.parse(release.notes_en) : null;
---
<Base title={`${app.name} ${release.version} · 中文更新说明`}>
  <section class="card">
    <p style="margin:0">
      <a href={`/${appId}/`}>← {app.name} 历史版本</a>
    </p>
    <h2 style="margin-top:0.5rem">{app.name} <span class="badge">{release.version}</span></h2>
    {release.released_at && <p class="meta">官方发布于 {release.released_at}</p>}
    <p class="meta">本站抓取于 {new Date(release.fetched_at).toLocaleString("zh-CN", { hour12: false })}</p>
  </section>

  <section class="card">
    <h3 style="margin-top:0">下载</h3>
    {release.files.map((f) => (
      <details open>
        <summary>
          <strong>{platformLabel(f.platform, f.arch)}</strong>
          <span class="meta"> · {f.filename} · {formatBytes(f.size_bytes)}</span>
        </summary>
        <p style="margin:0.75rem 0">
          <a class="btn" href={f.url} download>直接下载</a>
        </p>
        <p class="meta" style="word-break:break-all">
          SHA-256：<code>{f.sha256}</code>
        </p>
        <p class="meta">官方原始链接：<a href={f.source_url} target="_blank" rel="noopener">{f.source_url}</a></p>
      </details>
    ))}
    {appId === "codex-desktop" && app.windows_redirect && (
      <p>
        <strong>Windows 用户：</strong>Codex Windows 版仅通过 Microsoft Store 分发，请前往
        <a href={app.windows_redirect} target="_blank" rel="noopener"> Microsoft Store</a> 下载。
      </p>
    )}
  </section>

  {zhHtml && (
    <section class="card">
      <h3 style="margin-top:0">中文更新说明</h3>
      <div set:html={zhHtml} />
    </section>
  )}

  {enHtml && (
    <section class="card">
      <details>
        <summary><strong>英文原文</strong></summary>
        <div set:html={enHtml} />
      </details>
    </section>
  )}

  {!zhHtml && !enHtml && (
    <section class="card">
      <p class="meta">官方未发布该版本的更新说明。</p>
    </section>
  )}
</Base>
